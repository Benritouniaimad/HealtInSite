# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Data files
*.csv text eol=lf

# Binary files
*.pkl binary
*.joblib binary
*.pyc binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
